# Google Cloud & Gemini Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud Pub/Sub
PUBSUB_TOPIC_MANDATES=mandate-events
PUBSUB_SUBSCRIPTION_MANDATES=mandate-events-sub

# Google Cloud Firestore
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST= # optional for local testing

# Base Sepolia / Web3 (x402 Settlement Rail)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SETTLEMENT_PRIVATE_KEY=your-testnet-private-key-here
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e # Base Sepolia Test USDC

# Wardstone Circuit Breaker Policy Defaults
RISK_THRESHOLD_HOLD=60.0
MAX_VELOCITY_PER_HOUR=500.0 # USDC max spend velocity
CIRCUIT_BREAKER_MODE=enforce # enforce | monitor | simulate
